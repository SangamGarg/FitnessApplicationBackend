# Example names only. Spring Boot does not load this file automatically.
# Supply these values through the process environment or IDE run configuration.
SERVER_PORT=8081

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/appfitness
DB_USERNAME=postgres
DB_PASSWORD=

# Generate unique secure values; JWT_SECRET_KEY must contain at least 32 bytes.
JWT_SECRET_KEY=
JWT_CREATION_SECRET_KEY=

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_PROJECT_ID=

# SMTP
SPRING_EMAIL_SENDER_USERNAME=
SPRING_EMAIL_SENDER_PASSWORD=

# Initial portal administrator (password must be at least 12 characters)
FITNESS_PORTAL_ADMIN_EMAIL=
FITNESS_PORTAL_ADMIN_PASSWORD=
FITNESS_PORTAL_ADMIN_NAME=Portal Admin
FITNESS_PORTAL_BASE_URL=http://localhost:5173

# Runtime
SWAGGER_ENABLED=true
APP_LOG_DIR=./logs
# Set to true when deployed over HTTPS.
PORTAL_AUTH_COOKIE_SECURE=false

# Portal login failures are limited to five per email/client pair in 15 minutes.
# This limiter is process-local; a clustered deployment needs shared rate-limit storage.
